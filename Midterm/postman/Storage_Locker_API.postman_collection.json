{
  "info": {
    "name": "Storage Locker Management API",
    "description": "Midterm project. Run the requests top to bottom (or use Run collection): numbered requests follow the full workflow, the others demonstrate error cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "1. Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Database connected\", () => pm.expect(pm.response.json().database).to.eql(\"connected\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Checks that the API is running and can reach PostgreSQL."
          }
        }
      ]
    },
    {
      "name": "Lockers",
      "item": [
        {
          "name": "2. Create locker",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"locker_number\", \"A-\" + Math.floor(Math.random() * 90000 + 10000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "const locker = pm.response.json();",
                  "pm.collectionVariables.set(\"locker_id\", locker.id);",
                  "pm.test(\"New locker is available\", () => pm.expect(locker.is_available).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/lockers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "lockers"
              ]
            },
            "description": "Creates a locker. A unique locker number is generated in the pre-request script; the new ID is saved to {{locker_id}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"number\": \"{{locker_number}}\",\n  \"size\": \"MEDIUM\",\n  \"hourly_rate\": \"500.00\",\n  \"is_active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
