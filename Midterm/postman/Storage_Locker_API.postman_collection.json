            "description": "Rents the locker for 3 hours. Price = 750.00 * 3 = 2250.00. The new ID is saved to {{rental_id}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"locker_id\": \"{{locker_id}}\",\n  \"customer_name\": \"Aisultan\",\n  \"duration_hours\": 3\n}",
              "options": {
