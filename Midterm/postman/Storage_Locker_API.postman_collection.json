        {
          "name": "6. List available lockers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().map(l => l.id);\nconst lockerId = Number(pm.collectionVariables.get(\"locker_id\"));",
                  "pm.test(\"Our locker is available\", () => pm.expect(ids).to.include(lockerId));"
